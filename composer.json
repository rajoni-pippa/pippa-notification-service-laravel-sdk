{
    "name": "pippa/notification-sdk-laravel",
    "description": "Notification Service SDK for Laravel — Guzzle, ServiceProvider, Facade",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "notification",
        "sms",
        "email",
        "inapp",
        "laravel",
        "sdk"
    ],
    "authors": [
        {
            "name": "Rajoni",
            "email": "rajoni.pippa@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Pippa\\NotificationSdkLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pippa\\NotificationSdkLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pippa\\NotificationSdkLaravel\\NotificationServiceProvider"
            ],
            "aliases": {
                "NotificationService": "Pippa\\NotificationSdkLaravel\\Facades\\NotificationService"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}